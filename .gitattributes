# Normalise text files to LF in the repository and working tree
* text=auto
.gitattributes text eol=lf

# Explicitly use LF for project files
*.py text eol=lf
*.ipynb text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf

# Preserve Windows line endings for batch scripts
*.bat text eol=crlf
*.cmd text eol=crlf
